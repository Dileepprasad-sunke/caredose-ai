# CareDose AI — Environment Variables Template
# Copy this file to `.env` and fill in your values. Never commit `.env` to Git!

# Secret key used to sign session tokens (change in production)
CAREDOSE_SECRET_KEY=replace-with-a-random-secret-string

# Optional: LLM API keys for natural-language phrasing (system works out-of-the-box without keys via deterministic engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Custom path for persistent SQLite database file
CAREDOSE_DB_PATH=./database/caredose.db

# Frontend -> Backend URL when running Vite dev server
VITE_API_URL=http://127.0.0.1:8000
